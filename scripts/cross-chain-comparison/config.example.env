# Cross-Chain NFT Ownership Comparison Configuration
# Copy these variables to your .env file in the project root and fill in your actual values

# ===========================================
# ALCHEMY API KEY & COLLECTION NAME
# ===========================================
# Get your API key from https://www.alchemy.com/
# This single API key will be used across all chains

ALCHEMY_API_KEY=your_alchemy_api_key_here
COLLECTION_NAME=Your NFT Collection Name

# ===========================================
# CONTRACT ADDRESSES
# ===========================================
# Contract addresses are now hardcoded in the script configuration
# You can modify them directly in scripts/cross-chain-comparison/compareOwnersAcrossChains.ts
# Current addresses:
# - BaseSepolia: 0x86935f11c86623dec8a25696e1c19a8659cbf95d
# - Polygon: 0x86935f11c86623dec8a25696e1c19a8659cbf95d 