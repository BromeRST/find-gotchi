# ERC1155 Cross-Chain Comparison Configuration
# Copy these variables to your .env file in the project root and fill in your actual values

# ===========================================
# ALCHEMY API KEY
# ===========================================
# Get your API key from https://www.alchemy.com/
# This single API key will be used across all chains

ALCHEMY_API_KEY=your_alchemy_api_key_here

# ===========================================
# CONFIGURATION NOTES
# ===========================================
# Contract addresses and collection names are now hardcoded in the scripts:
# - Single collection: Edit compareOwnersAcrossChains.ts
# - Multi-collection: Edit runAllCollections.ts
# 
# No additional environment variables are needed for normal usage.